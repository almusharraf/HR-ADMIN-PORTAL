DB_HOST=127.0.0.1
DB_NAME=petrogistix
DB_USER=root
DB_PASS=
DB_PORT=3306

# Absolute path to the careers-site repo's backend/storage/uploads directory,
# so this portal can serve CV downloads for applications that repo received.
# Leave blank to use this repo's own backend/storage/uploads (fine for
# testing with mock data, wrong once the two repos run side by side for real
# — CVs physically live wherever the careers site's apply.php saved them).
# Example: /var/www/petrogistix-careers/backend/storage/uploads
CAREERS_UPLOADS_PATH=

# Session/cookie
APP_SECRET=change-me-to-a-long-random-string
SESSION_NAME=pgx_hr_session

# Anthropic (AI scoring)
ANTHROPIC_API_KEY=
ANTHROPIC_SCORE_MODEL=claude-sonnet-5

# Base path if the portal is mounted under a subdirectory, e.g. /hr
APP_BASE_PATH=
